# Copie ce fichier en .env.local pour changer les valeurs (ce fichier-là n'est pas commité).

# Adresse de l'API en production, par exemple https://api.mon-eglise.org
# Laisser vide en développement : le proxy de Vite relaie /api vers le backend.
VITE_API_URL=

# Adresse du backend utilisée par le proxy en développement.
VITE_API_PROXY_TARGET=http://localhost:5226
